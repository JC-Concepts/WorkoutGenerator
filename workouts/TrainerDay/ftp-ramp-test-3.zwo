<workout_file>
	<author>TrainerDay - Jcnc</author>
	<name>FTP ramp test</name>
	<description>Based on a popular FTP ramp test, but with a longer warming up and cooling down. Cycle till exhaustion, take the average of the last minute of effort and multiply it by 0.75, that&apos;s your FTP. You don&apos;t need to finish the ramp or each individual minute. Stop when you are exhausted.</description>
	<sportType>bike</sportType>
	<tags>
		<tag name="trainerDay"/>
	</tags>
	<workout>
		<Warmup Duration="120" PowerLow="0.28" PowerHigh="0.28"/>
		<SteadyState Duration="120" Power="0.37"/>
		<SteadyState Duration="120" Power="0.46"/>
		<SteadyState Duration="180" Power="0.52"/>
		<SteadyState Duration="180" Power="0.58"/>
		<SteadyState Duration="300" Power="0.46"/>
		<SteadyState Duration="60" Power="0.52"/>
		<SteadyState Duration="60" Power="0.58"/>
		<SteadyState Duration="60" Power="0.64"/>
		<SteadyState Duration="60" Power="0.7"/>
		<SteadyState Duration="60" Power="0.76"/>
		<SteadyState Duration="60" Power="0.82"/>
		<SteadyState Duration="60" Power="0.88"/>
		<SteadyState Duration="60" Power="0.94"/>
		<SteadyState Duration="60" Power="1"/>
		<SteadyState Duration="60" Power="1.06"/>
		<SteadyState Duration="60" Power="1.12"/>
		<SteadyState Duration="60" Power="1.18"/>
		<SteadyState Duration="60" Power="1.24"/>
		<SteadyState Duration="60" Power="1.3"/>
		<SteadyState Duration="60" Power="1.36"/>
		<SteadyState Duration="60" Power="1.42"/>
		<SteadyState Duration="60" Power="1.48"/>
		<SteadyState Duration="60" Power="1.54"/>
		<SteadyState Duration="60" Power="1.6"/>
		<SteadyState Duration="600" Power="0.52"/>
		<SteadyState Duration="180" Power="0.46"/>
		<SteadyState Duration="120" Power="0.37"/>
		<SteadyState Duration="120" Power="0.28"/>
	</workout>
</workout_file>