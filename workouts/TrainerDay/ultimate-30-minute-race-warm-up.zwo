		<SteadyState Duration="60" Power="0.8"/>
		<SteadyState Duration="60" Power="0.9"/>
		<SteadyState Duration="120" Power="0.4"/>
		<SteadyState Duration="90" Power="0.8"/>
		<SteadyState Duration="60" Power="0.4"/>
		<SteadyState Duration="90" Power="0.9"/>
		<SteadyState Duration="60" Power="0.4"/>
		<SteadyState Duration="90" Power="1"/>
		<SteadyState Duration="60" Power="0.4"/>
