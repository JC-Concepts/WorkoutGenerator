		<SteadyState Duration="30" Power="0.7" Cadence="85"/>
		<SteadyState Duration="45" Power="1" Cadence="100"/>
		<SteadyState Duration="30" Power="0.5" Cadence="80"/>
		<SteadyState Duration="20" Power="1.21" Cadence="90"/>
		<SteadyState Duration="45" Power="0.5" Cadence="85"/>
		<SteadyState Duration="15" Power="1.46" Cadence="100"/>
		<SteadyState Duration="90" Power="0.5" Cadence="80"/>
		<IntervalsT Repeat="8" OnDuration="20" OnPower="1.33" OffDuration="10" OffPower="0.45" Cadence="90"/>
		<SteadyState Duration="10" Power="0.5" Cadence="90"/>
		<SteadyState Duration="40" Power="0.8" Cadence="90"/>
