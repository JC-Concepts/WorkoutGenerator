		<SteadyState Duration="30" Power="0.85" Cadence="90"/>
		<SteadyState Duration="40" Power="0.88" Cadence="95"/>
		<SteadyState Duration="20" Power="0.9" Cadence="100"/>
		<SteadyState Duration="45" Power="0.4" Cadence="80"/>
		<SteadyState Duration="45" Power="0.5" Cadence="85"/>
		<IntervalsT Repeat="6" OnDuration="20" OnPower="1.22" OffDuration="10" OffPower="0.45" Cadence="100" CadenceResting="90"/>
