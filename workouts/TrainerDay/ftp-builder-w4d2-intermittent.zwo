<workout_file>
	<author>TrainerDay - skyracer</author>
	<name>FTP Builder  w4d2  Intermittent</name>
	<description>Intermittent: This training is a way to introduce short high intensity riding alterating it with short recovery, allowing the rider to recover and accumulate time at an intensity that would be difficult to maintain if ridden consecutively.</description>
	<sportType>bike</sportType>
	<tags>
		<tag name="trainerDay"/>
	</tags>
	<workout>
		<SteadyState Duration="120" Power="0.4"/>
		<SteadyState Duration="120" Power="0.44"/>
		<SteadyState Duration="120" Power="0.48"/>
		<SteadyState Duration="120" Power="0.53"/>
		<SteadyState Duration="120" Power="0.55"/>
		<IntervalsT Repeat="3" OnDuration="300" OnPower="0.88" OffDuration="120" OffPower="0.52" Cadence="90"/>
		<IntervalsT Repeat="6" OnDuration="30" OnPower="1" OffDuration="30" OffPower="0.73" Cadence="90"/>
		<SteadyState Duration="240" Power="0.52"/>
		<IntervalsT Repeat="6" OnDuration="30" OnPower="1" OffDuration="30" OffPower="0.73" Cadence="90"/>
		<SteadyState Duration="240" Power="0.52"/>
		<IntervalsT Repeat="6" OnDuration="30" OnPower="1" OffDuration="30" OffPower="0.73" Cadence="90"/>
		<SteadyState Duration="240" Power="0.4"/>
	</workout>
</workout_file>