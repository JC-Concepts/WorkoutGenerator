<workout_file>
	<author>TrainerDay - gzexpat</author>
	<name>Aerobic Threshold 1 hour</name>
	<description>Targetting the first lactate threshold, the point before lactate increases above resting levels. Typically 75% of MHR, 85% of FTP.</description>
	<sportType>bike</sportType>
	<tags>
		<tag name="trainerDay"/>
	</tags>
	<workout>
		<SteadyState Duration="60" Power="0.4"/>
		<SteadyState Duration="60" Power="0.5"/>
		<SteadyState Duration="60" Power="0.6"/>
		<SteadyState Duration="60" Power="0.7"/>
		<SteadyState Duration="60" Power="0.8"/>
		<SteadyState Duration="60" Power="0.9"/>
		<SteadyState Duration="60" Power="1"/>
		<SteadyState Duration="120" Power="0.6"/>
		<IntervalsT Repeat="2" OnDuration="360" OnPower="0.85" OffDuration="300" OffPower="0.82"/>
		<SteadyState Duration="120" Power="0.4"/>
		<IntervalsT Repeat="2" OnDuration="420" OnPower="0.85" OffDuration="300" OffPower="0.82"/>
		<SteadyState Duration="60" Power="0.6"/>
		<SteadyState Duration="60" Power="0.5"/>
		<SteadyState Duration="60" Power="0.4"/>
	</workout>
</workout_file>