<workout_file>
	<author>Jarvis Chau (via TrainingPeaks)</author>
	<name>VO2Max Four Fours</name>
	<description>One of TrainingPeaks Virtual&apos;s classic workouts:
Four Fours.

A solid warm-up, followed by 4x 4 minute efforts at VO2max. Simple, but effective.</description>
	<sportType>bike</sportType>
	<tags/>
	<workout>
		<Warmup Duration="540" PowerHigh="0.7" PowerLow="0.5" Cadence="90">
			<textevent timeoffset="0" message="!TextEvents:{
10:Welcome to VO2Max Four Fours;
20:This classic workout is perfect for improving your VO2Max.;
30:We&amp;apos;ll do four blocks of 4 minutes well above your FTP, but with plenty of rest inbetween.;
60:For now, focus on warming up, and getting your legs spinning.;
270:Half way through the warmup.;
480:1 minute to go.;
}"/>
		</Warmup>
		<SteadyState Duration="240" Power="1.12">
			<textevent timeoffset="0" message="!TextEvents:{
0:Bring the power right up now.;
30:Keep focusing on spinning the legs.;
60:First minute done.
Good job.;
120:Now the work really starts.  Settle in and focus on smooth pedalling.;
180:1 minute to go.;
210:30 seconds to go.;
230:10 seconds to go.;
}"/>
		</SteadyState>
		<SteadyState Duration="300" Power="0.55">
			<textevent timeoffset="0" message="!TextEvents:{
0:...and relax.;
30:Take on some fluids and take your time to recover.;
240:There&apos;s just 1 minute left until the next effort.;
270:30 seconds to go.;
290:10 seconds to go.;
}"/>
		</SteadyState>
